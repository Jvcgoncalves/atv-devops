# API
PORT=3001
CORS_ORIGINS=http://localhost:5173

# Supabase (server-only; never use VITE_* for these values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative accepted by API:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# MQTT (Nest is sole ingestion owner)
MQTT_ENABLED=true
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=hvac/#
# Optional fallback for legacy topics without sala segment:
# MQTT_DEFAULT_ROOM_ID=sala-1
MQTT_USERNAME=
MQTT_PASSWORD=

# WebSocket auth/origin controls
REALTIME_ALLOWED_ORIGINS=http://localhost:5173
# Required outside local development:
# REALTIME_AUTH_TOKEN=replace_me
