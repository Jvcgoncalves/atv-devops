# API
PORT=3001
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# SQLite legacy path is frozen. Leave SQLITE_WRITE_MODE unset.
# Only a separately approved rollback procedure may use SQLITE_WRITE_MODE=rollback.

# Supabase (server-only; never use VITE_* for these values)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative accepted by API:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# MQTT (Nest is sole ingestion owner)
MQTT_ENABLED=true
MQTT_URL=mqtt://broker.hivemq.com:1883
# Comma-separated subscriptions: canonical topics + existing ESP32 topic.
MQTT_TOPIC=hvac/sala/+/telemetria,tcc-hvac-kaue/airquality
MQTT_DEFAULT_ROOM_ID=sala-1
# Exact legacy topic(s) without sala segment; map to MQTT_DEFAULT_ROOM_ID.
MQTT_LEGACY_TOPIC=tcc-hvac-kaue/airquality
MQTT_USERNAME=
MQTT_PASSWORD=

# WebSocket auth/origin controls
REALTIME_ALLOWED_ORIGINS=http://localhost:5173
# Required outside local development:
# REALTIME_AUTH_TOKEN=replace_me
