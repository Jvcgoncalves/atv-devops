{
  "name": "@hvac/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API NestJS de compatibilidade do sistema HVAC",
  "scripts": {
    "start": "node --loader ts-node/esm src/main.ts",
    "dev": "node --watch --loader ts-node/esm src/main.ts",
    "init-db": "node --experimental-strip-types db.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:mqtt && npm run test:websocket",
    "test:unit": "node --import tsx --test test/api-unit.test.ts",
    "test:integration": "node --import tsx --test test/repository.test.ts",
    "test:e2e": "node --import tsx --test test/http-contract.test.ts",
    "test:mqtt": "node --import tsx --test test/mqtt.test.ts",
    "test:websocket": "node --import tsx --test test/realtime.test.ts"
  },
  "dependencies": {
    "@hvac/domain": "1.0.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@supabase/supabase-js": "^2.112.4",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13"
  }
}
