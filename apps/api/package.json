{
  "name": "@hvac/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API NestJS + Supabase do sistema HVAC",
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "dev": "node --watch --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npx tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:mqtt && npm run test:websocket",
    "test:unit": "node --import tsx --test test/api-unit.test.ts test/cutover.test.ts test/operations.test.ts",
    "test:integration": "node --import tsx --test test/repository.test.ts",
    "test:e2e": "node --import tsx --test test/http-contract.test.ts",
    "test:mqtt": "node --import tsx --test test/mqtt.test.ts",
    "test:websocket": "node --import tsx --test test/realtime.test.ts"
  },
  "dependencies": {
    "@hvac/domain": "1.0.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@supabase/supabase-js": "^2.112.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "mqtt": "^5.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/node": "^26.4.0",
    "typescript": "^5.7.2"
  }
}
