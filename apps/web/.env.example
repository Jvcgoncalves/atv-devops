# Copie para .env para usar o backend Nest real.
VITE_API_MODE=real
VITE_API_BASE=/api

# Target somente do proxy de desenvolvimento Vite -> Nest.
# Nao use VITE_ aqui: valor nao precisa ir para bundle do navegador.
API_PROXY_TARGET=http://localhost:3001

# Opcional: origem direta do Socket.IO. Sem valor, usa proxy Vite /socket.io.
# VITE_REALTIME_URL=http://localhost:3001/realtime
# VITE_REALTIME_AUTH_TOKEN=token-local-ou-staging

# Para demo offline, use VITE_API_MODE=mock ou omita VITE_API_MODE.
