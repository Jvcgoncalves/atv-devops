{
  "name": "hvac-dashboard-tcc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monorepo do dashboard de automacao HVAC (TCC)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @hvac/web run dev",
    "dev:api": "npm --workspace @hvac/api run dev",
    "build": "npm run build:front && npm run build:api",
    "build:front": "npm --workspace @hvac/web run build",
    "build:api": "npm --workspace @hvac/api run build",
    "preview": "npm --workspace @hvac/web run preview",
    "test": "npm run test:api && npm run test:front",
    "test:api": "npm --workspace @hvac/api run test",
    "test:front": "npm --workspace @hvac/web run test"
  }
}
