{
  "name": "@hvac/domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Regras de dominio compartilhadas do sistema HVAC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-include=src/functions/*.ts --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 test/*.test.ts"
  },
  "dependencies": {
    "@hvac/contracts": "1.0.0"
  }
}
