{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/contracts/test/**/*.ts"
  ]
}
